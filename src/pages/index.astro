---
import "../global.scss";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Welcome Dawg"
  description="This is your starting page."
  showToc={false}
>
  <p>
    I'm looking for ambitious projects and a team I can learn from
    and grow with.
  </p>

  <p>
    All the content on this site will be in English so I can practice my
    writing. Maybe one day I’ll also publish things here in German or Japanese.
  </p>

  <script>
    const colors = [
      "#f5e0dc",
      "#f2cdcd",
      "#f5c2e7",
      "#cba6f7",
      "#f38ba8",
      "#eba0ac",
      "#fab387",
      "#f9e2af",
      "#a6e3a1",
      "#94e2d5",
      "#89dceb",
      "#74c7ec",
      "#89b4fa",
      "#b4befe",
    ];

    // GPT generated, it was the quickest way
    document.addEventListener("DOMContentLoaded", () => {
      const paragraphs = document.querySelectorAll("p");
      paragraphs.forEach((p) => {
        const color = colors[Math.floor(Math.random() * colors.length)];
        p.style.color = color;
      });
    });
  </script>
</BaseLayout>
